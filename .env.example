# Copy to .env (git-ignored) and adjust. Every variable has a working default; nothing here is
# required for a local run. DuckDB needs no credentials. If you swap in a server database, put
# its password here (e.g. GSS_DB_PASSWORD) and reference it from dbt/profiles.yml via env_var().

# Where the DuckDB file lives (absolute or relative to the repository root)
GSS_DB_PATH=data/gss.duckdb

# Raw extracts and their manifest
GSS_RAW_DIR=source/data/raw
GSS_EXTRACTS_MANIFEST=source/data/extracts.json

# Logs (JSON lines) and verbosity
GSS_LOG_DIR=logs
GSS_LOG_LEVEL=INFO

# dbt target from dbt/profiles.yml: dev (default) or ci
DBT_TARGET=dev
